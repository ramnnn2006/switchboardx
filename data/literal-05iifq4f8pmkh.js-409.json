      }
    ],
    "guard": {
      "naive": [
        "fetch/fetch",
        "gmail/search_emails",
        "gmail/send_email"
      ],
      "safe": [
        {
          "tool": "fetch/fetch",
          "consumes": [
            [
              "url",
              "url",
              "held"
            ]
          ],
          "yields": [
            [
              "content",
              "text"
            ]
          ],
          "risk": [
            "ingests_untrusted"
          ]
        },
        {
          "tool": "gmail/draft_email",
