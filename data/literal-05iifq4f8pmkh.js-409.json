      "reason": "Lethal trifecta: fetch/fetch ingests untrusted content, gmail/search_emails reads private data, gmail/send_email can exfiltrate. Cut the edge into the exfil sink; offering a draft you send yourself.",
      "legs": [
        "ingests_untrusted",
        "reads_private",
        "exfil_sink"
      ],
      "cut": [
        "gmail/search_emails",
        "gmail/send_email"
      ]
